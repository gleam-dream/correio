#!/usr/bin/env bash
# Real Chromium cookie and cross-site email-link navigation against local peers.
set -euo pipefail
cd "$(dirname "$0")/.."
CORREIO_BROWSER_CHROMIUM=$(command -v "${CORREIO_BROWSER_CHROMIUM:-chromium}")
export CORREIO_BROWSER_CHROMIUM
command -v node >/dev/null
"${CORREIO_BROWSER_CHROMIUM:-chromium}" --version
node --version
(cd apps/passwordless_demo && npm ci --no-fund --no-audit)
scripts/with-postgres.sh sh -c 'cd apps/passwordless_demo && gleam run -m browser_e2e'
